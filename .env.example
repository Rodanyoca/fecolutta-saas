# Renseigner .env.local ou les variables du processus. Aucune valeur sensible ici.
# Compte de service autorise a lire les classeurs FECOLUTTA.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# IDs du territoire et du referentiel FECOLUTTA fournis par l'utilisateur.
FECOLUTTA_STRUCTURE_TERRITORIALE_SPREADSHEET_ID=
FECOLUTTA_REFERENTIELS_SPREADSHEET_ID=
# Protections existantes : classeur utilisateurs propre a FECOLUTTA.
FECOLUTTA_USERS_SPREADSHEET_ID=
# Deux secrets FECOLUTTA aleatoires distincts, 32 caracteres minimum ; ne pas copier FECOT.
AUTH_SECRET=
AUTH_TELEMETRY_HMAC_KEY=
# Ancienne variable : uniquement garde anti-reutilisation. Ne pas renseigner.
FECOT_USERS_SPREADSHEET_ID=
# Support medias herite hors perimetre ; nouveaux televersements refuses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLUB_LOGOS_FOLDER_ID=
GOOGLE_DRIVE_CLUBS_FOLDER_ID=
